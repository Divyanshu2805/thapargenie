# Copy to .env. Never commit the populated file or paste its values into logs.
APP_ENV=local
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
CORS_ALLOWED_ORIGINS=http://localhost:5173
DJANGO_ADMIN_ENABLED=true

# PostgreSQL with pgvector is required (SQLite is not supported).
# Local:    docker compose up -d db
# Supabase: session pooler URL (port 5432) and DATABASE_SSL_REQUIRE=true
DATABASE_URL=postgres://thapargpt:thapargpt@127.0.0.1:54329/thapargpt
DATABASE_SSL_REQUIRE=false
# Optional: tests default to DATABASE_URL and create a separate test_ database.
TEST_DATABASE_URL=

# Firebase Admin uses Application Default Credentials outside the emulator
# (set GOOGLE_APPLICATION_CREDENTIALS to a service-account file kept outside the repo).
# For emulator-only work, set FIREBASE_AUTH_EMULATOR_HOST without an http:// prefix.
FIREBASE_PROJECT_ID=
FIREBASE_AUTH_EMULATOR_HOST=
FIREBASE_ALLOWED_SIGN_IN_PROVIDERS=password,google.com
FIREBASE_RECENT_AUTH_SECONDS=300
FIREBASE_CLOCK_SKEW_SECONDS=10
# Supabase Storage (private bucket for uploaded documents).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=documents

# Throttles (DRF rate syntax).
THROTTLE_USER=120/min
