# Copy to .env. Never commit the populated file or paste its values into logs.
APP_ENV=local
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
CORS_ALLOWED_ORIGINS=http://localhost:5173
DJANGO_ADMIN_ENABLED=true

# PostgreSQL with pgvector is required (SQLite is not supported).
# Local:    docker compose up -d db
# Supabase: session pooler URL (port 5432) and DATABASE_SSL_REQUIRE=true
DATABASE_URL=postgres://thapargenie:thapargenie@127.0.0.1:54329/thapargenie
DATABASE_SSL_REQUIRE=false
# Optional: tests default to DATABASE_URL and create a separate test_ database.
TEST_DATABASE_URL=

# Firebase Admin uses Application Default Credentials outside the emulator
# (set GOOGLE_APPLICATION_CREDENTIALS to a service-account file kept outside the repo).
# For emulator-only work, set FIREBASE_AUTH_EMULATOR_HOST without an http:// prefix.
FIREBASE_PROJECT_ID=
FIREBASE_AUTH_EMULATOR_HOST=
FIREBASE_ALLOWED_SIGN_IN_PROVIDERS=password,google.com
FIREBASE_RECENT_AUTH_SECONDS=300
FIREBASE_CLOCK_SKEW_SECONDS=10

# LLM providers: gemini | openai. Check the provider docs for current model names.
LLM_PROVIDER=gemini
EMBED_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=
CHAT_MODEL=gemini-3.8-flash
FAST_MODEL=gemini-3.5-flash-lite
EMBED_MODEL=gemini-embedding-2
EMBED_DIMENSIONS=768

# Supabase Storage (private bucket for uploaded documents).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=documents

# Ingestion limits.
INGEST_URL_ALLOWLIST=thapar.edu,*.thapar.edu,static.npfs.co
# With approval switched off in Admin -> Settings, only these email domains get in directly.
OPEN_ACCESS_EMAIL_DOMAINS=thapar.edu
# Staff enter an authenticator-app code after signing in. Set to false for local work.
STAFF_TWO_FACTOR_REQUIRED=true
INGEST_MAX_FILE_MB=25
INGEST_MAX_PAGES=300

# Throttles (DRF rate syntax).
THROTTLE_USER=120/min
THROTTLE_ASK=6/min
THROTTLE_ADMIN_WRITE=30/min

# Reasoning level for quick structured calls ("" = model default).
FAST_THINKING=minimal
# Reasoning level for the streamed answer ("" = model default).
ANSWER_THINKING=low
