# Copy to .env. Never commit the populated file or paste its values into logs.
APP_ENV=local
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
CORS_ALLOWED_ORIGINS=http://localhost:5173
DJANGO_ADMIN_ENABLED=true

# PostgreSQL with pgvector is required (SQLite is not supported).
# Local:    docker compose up -d db
# Supabase: session pooler URL (port 5432) and DATABASE_SSL_REQUIRE=true
DATABASE_URL=postgres://thapargpt:thapargpt@127.0.0.1:54329/thapargpt
DATABASE_SSL_REQUIRE=false
# Optional: tests default to DATABASE_URL and create a separate test_ database.
TEST_DATABASE_URL=
# Throttles (DRF rate syntax).
THROTTLE_USER=120/min
